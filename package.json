{
  "name": "blockchain-escrow-audit",
  "version": "1.0.0",
  "private": true,
  "description": "Security-aware Solidity escrow and event audit platform",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "lint": "solhint 'contracts/**/*.sol'",
    "deploy:local": "hardhat run scripts/deploy.js",
    "demo:local": "hardhat run scripts/demo-flow.js --network localhost",
    "audit:events": "hardhat run scripts/inspect-events.js --network localhost"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@openzeppelin/contracts": "^5.0.2",
    "hardhat": "^2.22.5",
    "solhint": "^5.0.3"
  }
}
